{
  "excluded": [
    {
      "reason": "private identity and development provenance",
      "scope": ".git and internal history"
    },
    {
      "reason": "secret and operational metadata",
      "scope": ".env, e.env, credentials, private infrastructure"
    },
    {
      "reason": "artifact-only release; LaTeX is prohibited",
      "scope": "paper source and paper PDF"
    },
    {
      "reason": "review material is outside scientific evidence",
      "scope": "openreview and peer-review text"
    },
    {
      "reason": "private workflow material",
      "scope": "agent and planning documents"
    },
    {
      "reason": "not canonical paper evidence",
      "scope": "unselected development/failure runs"
    },
    {
      "reason": "minimize operational metadata and debris",
      "scope": "provider request journals duplicated by frozen captures"
    },
    {
      "reason": "retrospective exploratory scope; final records and code retained",
      "scope": "style packet/journal trees"
    },
    {
      "reason": "large third-party/reconstructible assets",
      "scope": "raw SWE-bench trajectories, Docker caches, datasets, evaluator images"
    },
    {
      "reason": "upstream terms and archive size",
      "scope": "third-party datasets and repositories"
    }
  ],
  "schema_version": 1
}
